        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorPrimaryContainer">@color/ink</item>
        <item name="colorOnPrimaryContainer">@color/bg</item>
        <item name="colorSecondaryContainer">#2A2926</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiaryContainer">#2A2926</item>
