<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Hauptbildschirm -->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:paddingBottom="16dp">

        <include layout="@layout/header" android:id="@+id/headerMain" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="168dp"
            android:layout_marginStart="-4dp"
            android:autoSizeMaxTextSize="164sp"
            android:autoSizeMinTextSize="60sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:background="@null"
            android:fontFamily="@font/instrument_serif"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="23:00"
            android:textColor="@color/ink" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/plex_mono"
            android:letterSpacing="0.01"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <LinearLayout
            android:id="@+id/switchRow"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/switchLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/plex_mono"
                android:letterSpacing="0.08"
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <app.nightfall.Toggle
                android:id="@+id/toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>

    <!-- Einmalige Einrichtung -->
    <LinearLayout
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/bg"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="28dp"
        android:visibility="gone">

        <include layout="@layout/header" android:id="@+id/headerSetup" />

        <TextView
            android:id="@+id/setupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:fontFamily="@font/instrument_serif"
            android:includeFontPadding="false"
            android:textColor="@color/ink"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/setupSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/plex_mono"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
